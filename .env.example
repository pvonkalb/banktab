# Copy to .env and edit. Every setting is optional.

# The address people use to reach the app. Required once email is set up, because it's
# used to build links in emails (password reset, confirm email, invites).
BUDGET_BASE_URL=https://budget.example.com

# "open" lets anyone sign up and create their own household. "closed" (default) means
# people can only join through an invite link from an existing household owner.
BUDGET_SIGNUP=closed
BUDGET_MAX_HOUSEHOLDS=100

# Force HTTPS-only cookies. The app already does this by itself when it sees HTTPS.
# BUDGET_SECURE_COOKIE=1

# Daily automatic backups kept in the data volume (0 turns them off). Copy them off the
# server too: a backup on the same disk won't survive the disk dying.
BUDGET_BACKUP_KEEP=14

# Link to this copy's source code, shown in Settings → Account. The AGPL-3.0 license asks
# that people using a modified version over the network can get its source.
# BUDGET_SOURCE_URL=https://github.com/you/budget

# Outgoing email. Without it, email links are printed to the log (fine for one household,
# not for sign-ups). Port 465 uses SSL; anything else uses STARTTLS.
# BUDGET_SMTP_HOST=smtp.example.com
# BUDGET_SMTP_PORT=587
# BUDGET_SMTP_USER=
# BUDGET_SMTP_PASSWORD=
# BUDGET_SMTP_FROM=Budget <budget@example.com>
